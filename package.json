{
    "name": "weixing-service",
    "version": "1.0.0",
    "description": "Express Node.js 后端服务，管理参数数据、远程重启设备和串口通信",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts --watch",
        "pkg:win": "npm run build && pkg -t node18-win-x64 -o dist/weixing-service-win.exe .",
        "pkg:mac": "npm run build && pkg -t node18-macos-x64 -o dist/weixing-service-mac .",
        "pkg:linux": "npm run build && pkg -t node18-linux-x64 -o dist/weixing-service-linux .",
        "pkg:all": "npm run build && pkg -t node18-win-x64,node18-macos-x64,node18-linux-x64 -o dist/weixing-service .",
        "test": "jest",
        "migrate:images": "ts-node src/scripts/migrateImages.ts",
        "db:vacuum": "ts-node src/scripts/vacuumDb.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@types/nedb": "^1.8.13",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.15.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.19.2",
        "morgan": "^1.10.0",
        "nedb": "^1.8.0",
        "node-cron": "^4.1.0",
        "node-ssh": "^13.1.0",
        "pg": "^8.16.0",
        "serialport": "^12.0.0",
        "winston": "^3.11.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/morgan": "^1.9.9",
        "@types/node": "^22.13.4",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3"
    },
    "bin": "dist/index.js",
    "pkg": {
        "assets": [
            "node_modules/**/*",
            ".env",
            "data/**/*"
        ],
        "targets": [
            "node18-win-x64",
            "node18-macos-x64",
            "node18-linux-x64"
        ],
        "outputPath": "dist"
    }
}